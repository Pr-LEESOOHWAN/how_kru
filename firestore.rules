rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{userId}: 본인 문서만 읽을 수 있음.
    // 진행도(레벨·XP·완료 목록)는 Cloud Function(completeMission)만 쓴다 - 사진 인증 티켓이
    // 있어야 완료가 기록된다. 예전엔 본인이면 모든 필드를 쓸 수 있어서 앱 밖에서 자기 레벨/XP를
    // 바꾸거나 인증 없이 완료 처리를 할 수 있었다(2026-10 수정).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // 가입(authService.signUp) 때 한 번: 진행도는 초기값만 허용.
      // (킥 답변 저장이 문서보다 먼저 와도 merge 생성이 되도록 필드가 없으면 초기값으로 본다)
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('current_level', 1) == 1
        && request.resource.data.get('level', 1) == 1
        && request.resource.data.get('xp', 0) == 0
        && request.resource.data.get('completed_dishes', []).size() == 0;

      // 그 뒤로는 진행도 필드를 건드리지 않는 수정(킥 답변 kick_choices 등)만 허용.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['current_level', 'level', 'levelName', 'xp', 'completed_dishes']);

      allow delete: if false;
    }

    // verifications(인증 티켓) / visits(방문 기록): Cloud Function(Admin SDK)만 읽고 쓴다.
    // 아래 기본 차단 규칙에 걸리므로 별도 match를 두지 않는다.

    // dishes / dishes_800 / levels: 로그인한 사용자는 읽기만 가능 (explore.tsx, levels.tsx,
    // dishService.ts가 참조). 쓰기는 클라이언트에서 막고, 시딩/이미지 업로드는
    // Admin SDK(서비스 계정)로 진행할 것.
    match /dishes/{dishId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /dishes_800/{dishId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // reviews/{reviewId}: 로그인한 사용자는 모두 읽기 가능. 작성은 본인 userId로만,
    // 수정/삭제는 막아둠(신고/모더레이션은 추후 Admin SDK로 처리).
    // reviews/{reviewId}/replies/{replyId}: 대댓글. 동일한 정책.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["replyCount"]);
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 그 외 모든 문서는 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
