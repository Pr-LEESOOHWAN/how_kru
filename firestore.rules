rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // users/{userId}: 본인 문서만 읽고 쓸 수 있음 (authService.signUp이 uid로 문서를 생성함)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // dishes / dishes_800 / levels: 로그인한 사용자는 읽기만 가능 (explore.tsx, levels.tsx,
    // dishService.ts가 참조). 쓰기는 클라이언트에서 막고, 시딩/이미지 업로드는
    // Admin SDK(서비스 계정)로 진행할 것.
    match /dishes/{dishId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /dishes_800/{dishId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // reviews/{reviewId}: 로그인한 사용자는 모두 읽기 가능. 작성은 본인 userId로만,
    // 수정/삭제는 막아둠(신고/모더레이션은 추후 Admin SDK로 처리).
    // reviews/{reviewId}/replies/{replyId}: 대댓글. 동일한 정책.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["replyCount"]);
      allow delete: if false;

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 그 외 모든 문서는 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
