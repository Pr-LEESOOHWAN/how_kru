{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // SDK 57에서 올라간 jest-expo(57.0.5)의 앰비언트 타입 선언(src/index.d.ts, "declare
    // namespace jest {...}")이 @types/jest보다 먼저 전역에 잡히면서 jest.fn/describe/it/
    // expect 등을 "네임스페이스를 값으로 쓸 수 없음" 오류로 만드는 문제가 있어(SDK 54에서는
    // 없었음), 전역으로 끌어올 앰비언트 타입 패키지를 명시적으로 jest/node로만 제한해서 회피.
    // (Places API 등에서 쓰는 process.env 때문에 node는 계속 필요)
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
