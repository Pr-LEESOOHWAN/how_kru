{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "compileOnSave": true,
  "include": ["src"],
  // 테스트 파일은 배포되는 lib/ 산출물에 안 들어가게 제외 (ts-jest가 테스트 실행 시엔
  // 이 tsconfig 대신 별도로 트랜스파일하므로 여기서 빠져도 jest 실행엔 영향 없음).
  "exclude": ["src/**/__tests__/**"]
}
